# Address of the Colyseus multiplayer server. Copy this file to .env.local to use it in `npm run dev`.
# On Vercel, add it as an environment variable instead (Project Settings > Environment Variables).
#
# Must be wss:// when the game is served over https. Leave empty for single-player only.
# `npm run dev` already defaults to ws://localhost:2567 when this is unset.
VITE_COLYSEUS_URL=wss://your-service.onrender.com
